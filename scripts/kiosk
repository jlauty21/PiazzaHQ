#!/usr/bin/env bash
#
# kiosk — control the Pi Calendar fullscreen display
# ---------------------------------------------------
# Stops or (re)starts the Chromium kiosk on demand, so you can get to the desktop
# for maintenance without racing an auto-relaunching browser.
#
#   kiosk off       hide the kiosk (kill Chromium), bring the cursor back
#   kiosk on        (re)launch the kiosk fullscreen
#   kiosk toggle    flip between on and off  (handy for a keyboard shortcut)
#   kiosk restart   cleanly relaunch (off then on)
#   kiosk status    show whether the kiosk is currently running
#
# Run it over SSH, or bind `kiosk toggle` to a keyboard shortcut (see README).
#
# Notes:
#  • This controls the BROWSER only. The Pi Calendar server keeps running, so the
#    display picks up right where it left off when you turn the kiosk back on.
#  • While the kiosk is off, the mouse cursor is restored (unclutter is paused)
#    so you can actually use the desktop.

set -uo pipefail

URL="${PI_CALENDAR_URL:-http://localhost:3000?nopreview}"
# ?nopreview is explicit and deterministic — without it, the page guesses "preview
# mode" from viewport size alone, and a smaller or portrait-oriented real display
# can trip that same guess (meant for the in-app layout-editor preview on a
# phone/tablet). Preview mode disables the cursor-hiding CSS rule among other
# things, which looks exactly like a cursor/unclutter problem but isn't one.
# Match any kiosk Chromium regardless of binary name (chromium vs chromium-browser).
KIOSK_MATCH="\-\-kiosk"
KIOSK_DEBUG_PORT="${PIAZZA_KIOSK_DEBUG_PORT:-9222}"
KIOSK_FLAGS="--kiosk --disable-gpu --disable-extensions --disable-component-update --disable-background-networking --disable-sync --disable-features=Translate --renderer-process-limit=1 --noerrdialogs --disable-infobars --disable-restore-session-state --check-for-update-interval=31536000 --remote-debugging-port=${KIOSK_DEBUG_PORT} --remote-allow-origins=http://127.0.0.1:${KIOSK_DEBUG_PORT}"
# --disable-gpu: some Pi/driver combos (e.g. VideoCore IV on a Pi 3 or
# earlier — no ES 3.0 support at all) fail to create a GLES 3.0 context,
# which cascades into real Chromium instability and a white screen that
# never resolves. Software rendering is plenty for this app's mostly-static
# content. The rest trims subsystems this kiosk never needs (extensions,
# background update checks, GCM registration retries, sync, translate),
# which matters on lower-RAM Pi's where Chromium's process tree is competing
# with the server's own boot-time work for headroom.
# --remote-debugging-port: lets scripts/kiosk-watchdog.js ask this specific
# tab's renderer "are you actually still executing JS?" via the Chrome
# DevTools Protocol — the only way to tell a genuinely frozen page apart
# from a browser process that's merely still alive (which is what the
# 2026-09-12 black-screen incident turned out to be). Binds to loopback
# only when no --remote-debugging-address is given — never reachable off
# this Pi. --remote-allow-origins: recent Chromium versions reject the
# DevTools HTTP/WS endpoints without an explicit allowed origin.

GRN=$'\033[32m'; YLW=$'\033[33m'; DIM=$'\033[2m'; RST=$'\033[0m'

# Sentinel file marking a DELIBERATE "kiosk off" — e.g. for maintenance.
# Anything that auto-recovers a hung/crashed kiosk (scripts/kiosk-watchdog.js)
# checks for this first and must never fight it. `kiosk on`/`toggle`-to-on
# clear it; only `kiosk off`/`toggle`-to-off set it.
OFF_SENTINEL="$HOME/.config/piazzahq-kiosk-off"

# Chromium goes by a few binary names depending on the OS build.
chromium_bin() {
  for b in chromium-browser chromium chromium-browser-v7; do
    command -v "$b" >/dev/null 2>&1 && { echo "$b"; return 0; }
  done
  echo "chromium-browser"
}

# Discover DISPLAY/WAYLAND_DISPLAY/XAUTHORITY for launching a GUI app outside
# an interactive desktop session — needed because neither an SSH shell nor a
# systemd timer inherits them the way running `kiosk` from the Ctrl+Alt+K
# keybind (in-session) does. Confirmed as a real gap: recovering a hung kiosk
# by hand over SSH failed silently ("Can't open display") until these were
# set explicitly. No-ops if already set (the in-session case).
#
# Order: (1) borrow env from a running compositor/WM process — tells us X11
# vs Wayland at the same time; (2) X11 fallback/correction via Xorg's own
# command line, which always carries its display number and -auth path
# directly (confirmed on real hardware: more reliable than assuming the WM's
# own environ has XAUTHORITY set — openbox's doesn't necessarily); (3) the
# conventional :0 / ~/.Xauthority default, if nothing above found anything.
discover_display_env() {
  if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then return 0; fi

  local wm_pid=""
  for name in labwc wayfire openbox; do
    wm_pid="$(pgrep -x "$name" | head -1)"
    [[ -n "$wm_pid" ]] && break
  done
  if [[ -n "$wm_pid" && -r "/proc/$wm_pid/environ" ]]; then
    local envdump; envdump="$(tr '\0' '\n' < "/proc/$wm_pid/environ" 2>/dev/null)"
    local d w x
    d="$(echo "$envdump" | sed -n 's/^DISPLAY=//p' | head -1)"
    w="$(echo "$envdump" | sed -n 's/^WAYLAND_DISPLAY=//p' | head -1)"
    x="$(echo "$envdump" | sed -n 's/^XAUTHORITY=//p' | head -1)"
    [[ -n "$d" ]] && export DISPLAY="$d"
    [[ -n "$w" ]] && export WAYLAND_DISPLAY="$w"
    [[ -n "$x" ]] && export XAUTHORITY="$x"
  fi

  if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
    local xorg_line; xorg_line="$(ps -eo args | grep -m1 '[X]org')"
    if [[ -n "$xorg_line" ]]; then
      export DISPLAY="$(echo "$xorg_line" | grep -oP '(?<= )(:[0-9]+)(?= |$)' | head -1)"
      local a; a="$(echo "$xorg_line" | grep -oP -- '-auth \K\S+')"
      [[ -n "$a" ]] && export XAUTHORITY="$a"
    fi
  fi

  [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && export DISPLAY=":0"
  [[ -z "${XAUTHORITY:-}" && -f "$HOME/.Xauthority" ]] && export XAUTHORITY="$HOME/.Xauthority"
}

is_running() {
  pgrep -f "$KIOSK_MATCH" >/dev/null 2>&1
}

kiosk_off() {
  mkdir -p "$(dirname "$OFF_SENTINEL")" && touch "$OFF_SENTINEL"
  if is_running; then
    # Kill the WHOLE kiosk Chromium process tree, not just the one process
    # matching --kiosk. A real incident (2026-09-12) traced a display that
    # got progressively less stable across repeated auto-recoveries back to
    # this exact line: `pkill -f "$KIOSK_MATCH"` only matches processes whose
    # OWN command line contains "--kiosk" literally — true for the top-level
    # browser process, but NOT for any of its children (Chromium's zygote,
    # GPU, utility, and renderer processes each get their own distinct
    # --type=... flags, never a copy of the parent's argv). So every prior
    # "kiosk off"/"kiosk restart" — manual or watchdog-triggered — killed
    # only the front door and left the entire rest of that instance's
    # process tree running as orphans, competing for the same limited RAM/
    # CPU with whatever got launched next. Confirmed on real hardware: the
    # stale process/tab count grew with every single restart cycle.
    #
    # The fix: Chromium's subprocesses inherit the browser process's own
    # process GROUP (confirmed on real hardware — every zygote/GPU/utility/
    # renderer process shared the exact same PGID as the main process; only
    # the separate crashpad-handler monitors sit outside it, which is fine,
    # they're inert without something to watch). Signaling the whole group
    # in one shot reaches all of them regardless of how many there are or
    # what flags they carry.
    while read -r pid; do
      [[ -z "$pid" ]] && continue
      pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')"
      [[ -z "$pgid" ]] && continue
      kill -TERM -- "-$pgid" 2>/dev/null || true
    done < <(pgrep -f "$KIOSK_MATCH")
    sleep 1
    # Safety net: anything that ignored SIGTERM (or was already mid-crash
    # and unresponsive to it) gets SIGKILL — this is exactly the failure
    # mode that let orphans survive before, so don't leave it to chance.
    while read -r pid; do
      [[ -z "$pid" ]] && continue
      pgid="$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')"
      [[ -z "$pgid" ]] && continue
      kill -KILL -- "-$pgid" 2>/dev/null || true
    done < <(pgrep -f "$KIOSK_MATCH")
    # Pause the cursor-hider so the desktop is usable.
    pkill -x unclutter 2>/dev/null || true
    # NOT pkill -x here: "unclutter-xfixes" is 16 characters, one over Linux's
    # 15-char /proc/pid/comm limit — the kernel truncates it to "unclutter-xfixe",
    # so an exact-name match against the untruncated string silently never
    # matches, leaving it running forever after "kiosk off" (confirmed on real
    # hardware: the process survives every "off", still hiding the cursor).
    # -f matches the full command line instead, which isn't truncated.
    pkill -f 'unclutter-xfixes' 2>/dev/null || true
    sleep 1
    echo "${YLW}Kiosk stopped.${RST} Desktop is now usable; cursor restored."
    echo "${DIM}Turn it back on with:  kiosk on${RST}"
  else
    echo "Kiosk is already off."
  fi
}

kiosk_on() {
  rm -f "$OFF_SENTINEL"
  if is_running; then
    echo "Kiosk is already running."
    return 0
  fi
  discover_display_env
  local bin; bin="$(chromium_bin)"
  # Launch detached so it survives this shell/SSH session ending.
  nohup "$bin" $KIOSK_FLAGS "$URL" >/dev/null 2>&1 &
  disown 2>/dev/null || true
  # Restart the cursor-hider too (ignore if not installed). Prefer the Wayland-
  # capable xfixes build if present; fall back to classic unclutter on X11.
  if command -v unclutter-xfixes >/dev/null 2>&1; then
    # --start-hidden: on a kiosk with no real mouse, unclutter-xfixes otherwise
    # waits for a genuine pointer motion event before it first hides the cursor —
    # with no physical mouse to generate one, it can sit visible indefinitely.
    nohup unclutter-xfixes --timeout 1 --hide-on-touch --start-hidden >/dev/null 2>&1 & disown 2>/dev/null || true
  elif command -v unclutter >/dev/null 2>&1; then
    nohup unclutter -idle 0.1 -root >/dev/null 2>&1 & disown 2>/dev/null || true
  fi
  sleep 1
  if is_running; then
    echo "${GRN}Kiosk started.${RST} Showing ${URL}"
  else
    echo "${YLW}Tried to start the kiosk but it isn't showing as running.${RST}"
    echo "${DIM}If you're on a headless/SSH-only session, the kiosk needs the Pi's"
    echo "desktop session to be active on the physical screen.${RST}"
  fi
}

kiosk_status() {
  if is_running; then
    echo "${GRN}Kiosk is ON${RST} (Chromium kiosk running)."
  else
    echo "${YLW}Kiosk is OFF${RST}."
  fi
}

case "${1:-}" in
  off|stop)    kiosk_off ;;
  on|start)    kiosk_on ;;
  toggle)      if is_running; then kiosk_off; else kiosk_on; fi ;;
  restart)     kiosk_off; sleep 1; kiosk_on ;;
  status|"")   kiosk_status ;;
  *)
    echo "Usage: kiosk {on|off|toggle|restart|status}"
    exit 1
    ;;
esac
